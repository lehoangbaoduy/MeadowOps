# Unit 8 (MEADOWOPS-API-002): server-only — never prefixed NEXT_PUBLIC_, so
# these never reach the browser bundle. The Next.js server proxies admin
# CRUD requests to the FastAPI backend (see src/lib/admin-api.ts) and is the
# only thing that ever holds the real Builder bearer token; the browser only
# ever sees an httpOnly session cookie (src/app/api/login/route.ts).

# Must match the FastAPI backend's MEADOWOPS_BUILDER_TOKEN (repo-root .env).
MEADOWOPS_BUILDER_TOKEN=

# Base URL of the FastAPI backend (backend/app/main.py), no trailing slash.
MEADOWOPS_API_BASE_URL=http://localhost:8000
