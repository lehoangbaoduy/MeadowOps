# Unit 8 (MEADOWOPS-API-002): server-only — never prefixed NEXT_PUBLIC_, so
# these never reach the browser bundle. The Next.js server proxies admin
# CRUD requests to the FastAPI backend (see src/lib/admin-api.ts); the
# browser only ever sees an httpOnly session cookie
# (src/app/api/login/route.ts).
#
# Unit 17a (MEADOWOPS-DOM-010, PRD 5.1/8.4 amendment): there is no
# per-frontend shared secret anymore — /api/login posts the email+password
# the user typed straight through to the backend's own login endpoint,
# which is the only place credentials are ever checked.

# Base URL of the FastAPI backend (backend/app/main.py), no trailing slash.
MEADOWOPS_API_BASE_URL=http://localhost:8000

# Unit 21 (MEADOWOPS-UI-003, PRD 6.13): NEXT_PUBLIC_* on purpose — the chat
# WebSocket is opened directly from the browser (app/api/chat.py's
# `chat_ws` route has no Depends/cookie auth path available to it at all;
# see app/api/chat/ws-ticket/route.ts for the short-lived ticket minted
# server-side first). Security review (2026-09-03): a third-party site
# still can't obtain a ticket to open a rogue connection even though
# chat_ws itself never checks Origin — SESSION_COOKIE is `sameSite: "lax"`
# (src/app/api/login/route.ts), so it never attaches to a cross-site
# POST to /api/chat/ws-ticket in the first place. Production MUST set this
# to wss://, not ws:// — the ticket (and every message frame) travels in
# the clear otherwise.
NEXT_PUBLIC_MEADOWOPS_WS_BASE_URL=ws://localhost:8000
