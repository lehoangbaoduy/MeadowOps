# Copy to .env and fill in. Never commit .env (see .gitignore).

# Local Docker Compose Postgres superuser/owner credentials (backend app role).
MEADOWOPS_POSTGRES_PASSWORD=

# Full DSN the backend app (owner role, live+sandbox schemas) connects with.
MEADOWOPS_DATABASE_URL=postgresql+psycopg://meadowops:${MEADOWOPS_POSTGRES_PASSWORD}@localhost:5434/meadowops

# Restricted role used only by the SQL Query Playground sandbox (PRD 5.9, 8.4).
# Provisioned by the Unit 1 Alembic migration; password set here so it isn't
# hardcoded in migration source (CONST-SEC-001). The DSN itself is built at
# runtime from MEADOWOPS_DATABASE_URL's host/port/dbname (app/core/config.py
# Settings.sandbox_dsn()), not from a separate URL var here.
MEADOWOPS_SANDBOX_ROLE_PASSWORD=

# Unit 19 (MEADOWOPS-DOM-012, PRD 5.9): app-enforced Query Playground
# statement timeout, in seconds — never the session's own statement_timeout
# GUC (app/services/query_execution.py's module docstring).
MEADOWOPS_QUERY_TIMEOUT_SECONDS=10.0

# Unit 20 (MEADOWOPS-API-004, DD-2): shared secret for Subsystem 2's internal
# httpx.AsyncClient (ASGITransport, in-process) to authenticate as the
# read-only "service" identity against require_authenticated routes — never
# accepted by require_admin or the Query Playground's own routes
# (app/core/auth.py). Generate via two concatenated `openssl rand -hex 16`
# calls (32 hex chars each = 64 total, min_length=32 is a character count,
# not a byte count) — same convention as MEADOWOPS_SESSION_SECRET_KEY.
MEADOWOPS_INTERNAL_SERVICE_TOKEN=

# Claude API (Phase 4, blocker B3, closed 2026-09-14 - verified live).
# ANTHROPIC_API_KEY is deliberately bare, not MEADOWOPS_-prefixed
# (app/core/config.py Settings.anthropic_api_key's own comment). Setting the
# key alone does NOT switch the app to a live Claude client -
# MEADOWOPS_CLAUDE_CLIENT_ENABLED must also be "true", kept as a separate
# off-by-default opt-in so a real key sitting in a local/CI .env never turns
# every test run into live billed API calls. This is not hypothetical -
# leaving both set in a local .env while running the backend test suite
# made 3 route tests (test_returns_503_when_no_claude_client_is_configured
# in TestSuggestPushbackRoute/TestSufficiencyCheckRoute/TestCompleteThreadRoute)
# fail by making real billed calls instead of hitting the 503 they assert.
# Leave both unset/false for local dev and testing (MockClaudeClient is the
# default posture); set MEADOWOPS_CLAUDE_CLIENT_ENABLED=true only transiently
# - as a one-off env var prefix when starting the server, never persisted in
# .env - for a manual live-Claude verification or demo, then unset it again
# before running tests.
ANTHROPIC_API_KEY=
MEADOWOPS_CLAUDE_CLIENT_ENABLED=false
# Per-call timeout passed straight to the Anthropic SDK client (seconds) -
# the app holds its DB session open across the call, so this is a real
# resource bound, not just a UX one. Default shown.
MEADOWOPS_CLAUDE_CLIENT_TIMEOUT_SECONDS=60.0

# Unit 17a (MEADOWOPS-DOM-010, PRD 5.1/8.4 amendment, DD-22): role-based
# login replaces the former single shared MEADOWOPS_BUILDER_TOKEN. Signs and
# verifies session tokens (JWT/HS256) — must be at least 32 bytes (RFC 7518
# 3.2).
MEADOWOPS_SESSION_SECRET_KEY=
MEADOWOPS_SESSION_TOKEN_EXP_HOURS=8

# Per-email login rate limiting (app/core/rate_limit.py) — defaults shown.
MEADOWOPS_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
MEADOWOPS_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Seeds the two known accounts (app/services/auth_seed.py) — run as a one-off
# script, not wired into app startup. A *_PASSWORD_HASH value takes
# precedence over the plaintext *_PASSWORD variant; plaintext is a
# documented local-dev convenience only.
MEADOWOPS_INITIAL_ADMIN_EMAIL=
MEADOWOPS_INITIAL_ADMIN_PASSWORD=
MEADOWOPS_INITIAL_ADMIN_PASSWORD_HASH=
MEADOWOPS_INITIAL_ANALYST_EMAIL=
MEADOWOPS_INITIAL_ANALYST_PASSWORD=
MEADOWOPS_INITIAL_ANALYST_PASSWORD_HASH=
